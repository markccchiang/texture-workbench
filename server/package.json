{
  "name": "@glcm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Texture Workbench API server",
  "scripts": {
    "start": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} tsx src/main.ts",
    "dev": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} tsx watch src/main.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@glcm/api": "0.1.0",
    "@glcm/native": "0.1.0",
    "fastify": "5.12.4",
    "fflate": "0.8.3",
    "tsx": "4.23.13",
    "typebox": "1.3.30"
  },
  "license": "MIT",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    }
  }
}
